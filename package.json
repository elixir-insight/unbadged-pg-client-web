{
	"name": "pg-client-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/patch-amplify-body-size-limit.mjs",
		"preview": "BODY_SIZE_LIMIT=20971520 vite preview",
		"prepare": "husky && playwright install chromium",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project server --run && vitest --project client --run",
		"test:storybook": "vitest --project storybook --run",
		"test": "npm run test:unit && npm run test:storybook && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"commit": "cz"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/config-conventional": "^21.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/figtree": "^5.2.10",
		"@fontsource-variable/inter": "^5.2.8",
		"@hugeicons/core-free-icons": "^4.2.1",
		"@hugeicons/svelte": "^1.1.3",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.4.6",
		"@storybook/sveltekit": "^10.4.6",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"amplify-adapter": "^1.3.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"commitizen": "^4.3.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.4.6",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"layerchart": "^2.0.0-next.48",
		"mode-watcher": "^1.1.0",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.60.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"storybook": "^10.4.6",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"config": {
		"commitizen": {
			"path": "./scripts/cz-adapter.cjs"
		},
		"cz-customizable": {
			"config": ".cz-config.cjs"
		}
	},
	"dependencies": {
		"d3-shape": "^3.2.0",
		"pino": "^10.3.1",
		"valibot": "^1.4.2"
	}
}
